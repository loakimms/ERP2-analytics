# Firebase Admin SDK (사용자관리 전체 목록 조회용)
# 이 파일을 복사해 env.firebase.admin.local로 저장하고 값을 채운 뒤,
# .gitignore에 의해 커밋되지 않도록 한다.
#
# ERP2-dev의 env.firebase-admin.local 또는 docker/.env.api.local과 동일한 형식.
# 서비스 계정 JSON에서 client_email, private_key를 복사한다.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
