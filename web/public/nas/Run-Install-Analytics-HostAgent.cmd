function Add-UniquePath([System.Collections.Generic.List[string]]$Items, [string]$Value) {
  if ([string]::IsNullOrWhiteSpace($Value)) { return }
  $normalized = $Value.Trim()
  if (-not $Items.Contains($normalized)) { $Items.Add($normalized) }
}

function Resolve-PowerShellExe {
  $candidates = New-Object 'System.Collections.Generic.List[string]'
  $pshomePwsh = $null
  $pshomeWindows = $null
  if (-not [string]::IsNullOrWhiteSpace($PSHOME)) {
    $pshomePwsh = Join-Path $PSHOME 'pwsh.exe'
    $pshomeWindows = Join-Path $PSHOME 'powershell.exe'
  }
  foreach ($value in @(
    $pshomePwsh,
    $pshomeWindows,
    "$env:ProgramFiles\PowerShell\7\pwsh.exe",
    "$env:ProgramFiles\PowerShell\6\pwsh.exe",
    "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe"
  )) {
    if (-not [string]::IsNullOrWhiteSpace($value) -and -not $candidates.Contains($value)) { $candidates.Add($value) | Out-Null }
  }
  foreach ($candidate in $candidates) {
    if (Test-Path -LiteralPath $candidate) { return $candidate }
  }
  $pwshCmd = Get-Command pwsh -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($pwshCmd -and $pwshCmd.Source) { return $pwshCmd.Source }
  $powershellCmd = Get-Command powershell -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($powershellCmd -and $powershellCmd.Source) { return $powershellCmd.Source }
  throw "PowerShell executable was not found."
}

function Add-ParentCandidates([System.Collections.Generic.List[string]]$Items, [string]$StartPath) {
  if ([string]::IsNullOrWhiteSpace($StartPath)) { return }
  $current = $StartPath
  while (-not [string]::IsNullOrWhiteSpace($current)) {
    Add-UniquePath $Items $current
    $canonicalFile = Join-Path $current "CANONICAL_ROOT.txt"
    if (Test-Path -LiteralPath $canonicalFile) {
      try {
        $canonicalRoot = (Get-Content -LiteralPath $canonicalFile -TotalCount 1 -ErrorAction Stop | Select-Object -First 1).Trim()
        Add-UniquePath $Items $canonicalRoot
      } catch {}
    }
    $parent = Split-Path -Parent $current
    if ([string]::IsNullOrWhiteSpace($parent) -or $parent -eq $current) { break }
    $current = $parent
  }
}

function Resolve-AnalyticsRepoRoot {
  $candidates = New-Object 'System.Collections.Generic.List[string]'
  Add-UniquePath $candidates $env:ERP2_ANALYTICS_ROOT
  Add-ParentCandidates $candidates $PSScriptRoot
  try { Add-ParentCandidates $candidates ((Get-Location).Path) } catch {}
  try {
    foreach ($driveRoot in (Get-PSDrive -PSProvider FileSystem | Select-Object -ExpandProperty Root)) {
      Add-UniquePath $candidates (Join-Path $driveRoot "dev\ERP2-analytics")
    }
  } catch {}
  Add-UniquePath $candidates "D:\dev\ERP2-analytics"
  Add-UniquePath $candidates "C:\dev\ERP2-analytics"

  foreach ($root in $candidates) {
    $agent = Join-Path $root "tools\host-agent.ps1"
    $start = Join-Path $root "tools\start-host-agent.ps1"
    $ensure = Join-Path $root "tools\ensure-host-agent.ps1"
    $menuScript = Join-Path $root "scripts\menu-sync-db-reconcile.ps1"
    if (
      (Test-Path -LiteralPath $agent) -and
      (Test-Path -LiteralPath $start) -and
      (Test-Path -LiteralPath $ensure) -and
      (Test-Path -LiteralPath $menuScript)
    ) {
      return $root
    }
  }
  return $null
}

