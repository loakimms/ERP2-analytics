function Write-Info([string] $m) { Write-Host ("[INFO] " + $m) -ForegroundColor Cyan }
function Write-Err([string] $m) { Write-Host ("[ERR] " + $m) -ForegroundColor Red }
function Write-Warn([string] $m) { Write-Host ("[WARN] " + $m) -ForegroundColor Yellow }

function Test-HostAgentTaskExists([string]$TaskName) {
  $null = & schtasks.exe /Query /TN "$TaskName" 2>$null
  return ($LASTEXITCODE -eq 0)
}

function Get-HostAgentTaskCommand([string]$TaskName) {
  $output = @(& schtasks.exe /Query /TN "$TaskName" /FO LIST /V 2>$null)
  if ($LASTEXITCODE -ne 0) { return "" }
  $joined = (($output | ForEach-Object { "$_" }) -join [Environment]::NewLine)
  $line = ($joined -split "`r?`n" | Where-Object { $_ -match "host-agent\.ps1|start-host-agent\.ps1|ERP2-Analytics-HostAgent" } | Select-Object -First 1)
  return [string]($line ?? "")
}

function Register-HostAgentTask([string]$TaskName, [string]$TaskRunCommand) {
  $output = @(& schtasks.exe /Create /TN "$TaskName" /TR "$TaskRunCommand" /SC ONLOGON /RL LIMITED /F 2>&1)
  $exitCode = $LASTEXITCODE
  if ($exitCode -eq 0) { return @{ reusedExisting = $false } }

  $detail = (($output | ForEach-Object { "$_" }) -join [Environment]::NewLine).Trim()
  if ([string]::IsNullOrWhiteSpace($detail)) {
    $detail = "schtasks.exe exited with code $exitCode"
  }

  if (Test-HostAgentTaskExists -TaskName $TaskName) {
    $currentTaskCommand = Get-HostAgentTaskCommand -TaskName $TaskName
    $resolvedInstallDir = [string](Resolve-Path -LiteralPath $InstallDir -ErrorAction SilentlyContinue)
    if ([string]::IsNullOrWhiteSpace($resolvedInstallDir)) { $resolvedInstallDir = [string]$InstallDir }
    $pointsAtInstallDir = $currentTaskCommand -and (
      $currentTaskCommand -like ("*" + $resolvedInstallDir + "*") -or
      $currentTaskCommand -like "*ERP2-Analytics-HostAgent*"
    )
    $portsOk = $currentTaskCommand -like "*-Port $Port*" -and $currentTaskCommand -like "*-CdpPort $CdpPort*"
    if ($pointsAtInstallDir -and $portsOk) {
      Write-Warn ("Task '{0}' could not be overwritten, but it already points to this install dir/ports. Reusing it." -f $TaskName)
      return @{ reusedExisting = $true; detail = $detail }
    }
    throw ("Task Scheduler registration failed for '{0}', and the existing command does not match this install dir/ports.`nCurrent command: {1}`nExpected command: {2}`nFix: run as administrator: schtasks /Delete /TN `"{0}`" /F, then install again.`nOriginal message: {3}" -f $TaskName, $currentTaskCommand, $TaskRunCommand, $detail)
  }

  throw ("Task Scheduler registration failed: {0}" -f $detail)
}

