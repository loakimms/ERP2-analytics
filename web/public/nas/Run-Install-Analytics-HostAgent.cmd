Write-TextUtf8NoBom -path $agentPath -content $agentScript
Write-TextUtf8NoBom -path $ensurePath -content $ensureScript
Write-TextUtf8NoBom -path $startPath -content $startScript
Write-TextUtf8NoBom -path $startChromePath -content $startChromeScript
Write-TextUtf8NoBom -path $stopChromePath -content $stopChromeScript
foreach ($menuSyncScriptPath in $menuSyncScriptPaths) {
  Write-TextUtf8NoBom -path $menuSyncScriptPath -content $unsupportedMenuSyncScript
}

try {
  $effectiveAgentPath = $agentPath
  $effectiveEnsurePath = $ensurePath
  $effectiveStartPath = $startPath
  $mode = "standalone (NAS/user PC)"

  # NAS 배포용 설치기는 항상 번들에 포함된 standalone agent를 사용한다.
  # PC에 과거 개발용 repo(D:\dev\ERP2-analytics, C:\dev\ERP2-analytics)가 남아 있어도
  # 그 repo의 tools\host-agent.ps1 를 우선 참조하면 self-update 후에도 예전 스크립트를 계속 실행하게 된다.
  # -> NAS 패키지 업데이트가 "안 된 것처럼" 보이는 원인이라, NAS 설치 경로에서는 repo override를 금지한다.

  $tr = "`"$pwsh`" -NoProfile -ExecutionPolicy Bypass -File `"$effectiveAgentPath`" -Port $Port -CdpPort $CdpPort"
  $taskResult = Register-HostAgentTask -TaskName $taskName -TaskRunCommand $tr
  Register-HostAgentStartProtocol -StartScriptPath $effectiveStartPath
  $ensureTaskRemoved = $false
  if (Test-HostAgentTaskExists -TaskName $taskNameEnsure) {
    $deleteOutput = @(& schtasks.exe /Delete /TN "$taskNameEnsure" /F 2>&1)
    if ($LASTEXITCODE -ne 0) {
      $deleteDetail = (($deleteOutput | ForEach-Object { "$_" }) -join [Environment]::NewLine).Trim()
      if ([string]::IsNullOrWhiteSpace($deleteDetail)) {
        $deleteDetail = "schtasks.exe exited with code $LASTEXITCODE"
      }
      throw ("기존 ensure 작업 삭제에 실패했습니다. 이 작업은 5분마다 빈 PowerShell 창을 띄울 수 있으므로 유지하지 않습니다.`n해결: 관리자 PowerShell에서 schtasks /Delete /TN `"{0}`" /F 후 다시 설치하세요.`n원본 메시지: {1}" -f $taskNameEnsure, $deleteDetail)
    }
    $ensureTaskRemoved = $true
  }

  Write-Host ""
  Write-Host "✅ 설치 완료: 로그온 시 Host Agent가 자동 실행됩니다." -ForegroundColor Green
  Write-Host " - mode: $mode"
  Write-Host " - install: $InstallDir"
  Write-Host " - task: $taskName"
  if ($ensureTaskRemoved) {
    Write-Host " - ensure-task: removed (no periodic PowerShell window)"
  } else {
    Write-Host " - ensure-task: disabled (no periodic PowerShell window)"
  }
  Write-Host " - protocol: erp2-analytics-host-agent://start"
  if ($taskResult.reusedExisting) { Write-Host " - task-status: 기존 작업 재사용" -ForegroundColor Yellow }
  Write-Host " - health: http://127.0.0.1:$Port/health"
  Write-Host ""
} catch {
  Write-Host ""
  Write-Err "설치 중 오류가 발생했습니다:"
  Write-Err $_.Exception.Message
  Write-Host ""
  if ($NoPause) { throw }
}

if (-not $NoPause) {
  Read-Host -Prompt "Press Enter to close this window"
