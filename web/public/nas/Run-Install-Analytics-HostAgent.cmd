$ensureScript = @'
param(
  [int]$Port = 9230,
  [int]$CdpPort = 9223
)

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

function Resolve-PowerShellExe {
  $candidates = New-Object 'System.Collections.Generic.List[string]'
  $pshomePwsh = $null
  $pshomeWindows = $null
  if (-not [string]::IsNullOrWhiteSpace($PSHOME)) {
    $pshomePwsh = Join-Path $PSHOME 'pwsh.exe'
    $pshomeWindows = Join-Path $PSHOME 'powershell.exe'
  }
  foreach ($value in @(
    $pshomePwsh,
    $pshomeWindows,
    "$env:ProgramFiles\PowerShell\7\pwsh.exe",
    "$env:ProgramFiles\PowerShell\6\pwsh.exe",
    "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe"
  )) {
    if (-not [string]::IsNullOrWhiteSpace($value) -and -not $candidates.Contains($value)) { $candidates.Add($value) | Out-Null }
  }
  foreach ($candidate in $candidates) {
    if (Test-Path -LiteralPath $candidate) { return $candidate }
  }
  $pwshCmd = Get-Command pwsh -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($pwshCmd -and $pwshCmd.Source) { return $pwshCmd.Source }
  $powershellCmd = Get-Command powershell -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($powershellCmd -and $powershellCmd.Source) { return $powershellCmd.Source }
  throw "PowerShell executable was not found."
}

function Test-AgentHealthy([int]$port) {
  try {
    $r = Invoke-WebRequest -UseBasicParsing -Uri ("http://127.0.0.1:{0}/health" -f $port) -TimeoutSec 1
    return ($r -and $r.StatusCode -ge 200 -and $r.StatusCode -lt 300)
  } catch { return $false }
}

function Ensure-BackgroundWorker([int]$port) {
  $configPath = Join-Path "$env:LOCALAPPDATA\ERP2-Analytics-HostChrome" "collector-background.config.json"
  if (-not (Test-Path -LiteralPath $configPath)) { return }
  try {
    $status = Invoke-RestMethod -Method Get -Uri ("http://127.0.0.1:{0}/collector/background/status" -f $port) -TimeoutSec 2
    if ($status -and $status.running) { return }
  } catch {}
  try {
    $raw = Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop
    if ([string]::IsNullOrWhiteSpace($raw)) { return }
    $cfg = $raw | ConvertFrom-Json
    $bearerToken = [string]($cfg.bearerToken ?? "")
    $collectorToken = [string]($cfg.collectorToken ?? "")
    if ([string]::IsNullOrWhiteSpace($bearerToken) -and [string]::IsNullOrWhiteSpace($collectorToken)) { return }
    Invoke-RestMethod -Method Post -Uri ("http://127.0.0.1:{0}/collector/background/start" -f $port) -ContentType "application/json" -Body $raw -TimeoutSec 5 | Out-Null
  } catch {}
}

if (Test-AgentHealthy -port $Port) {
  Ensure-BackgroundWorker -port $Port
  exit 0
}

$agent = Join-Path $PSScriptRoot "tools\host-agent.ps1"
$pwshExe = Resolve-PowerShellExe
Start-Process -FilePath $pwshExe -ArgumentList @(
  "-NoProfile",
  "-ExecutionPolicy", "Bypass",
  "-File", $agent,
  "-Port", $Port,
  "-CdpPort", $CdpPort
) -WindowStyle Hidden | Out-Null

for ($i = 0; $i -lt 20; $i++) {
  Start-Sleep -Milliseconds 500
  if (Test-AgentHealthy -port $Port) {
    Ensure-BackgroundWorker -port $Port
    exit 0
  }
}
'@

