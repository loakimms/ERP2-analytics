FROM node:20-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm set fund false \
 && npm set audit false \
 && npm config set registry https://registry.npmjs.org \
 && npm install --no-audit --no-fund

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY public ./public
COPY scripts ./scripts

ARG VITE_ANALYTICS_API_BASE_URL
# 기본은 동일 오리진 프록시(/api). (nginx-spa.conf에서 /api -> analytics-api:8000 프록시)
ENV VITE_ANALYTICS_API_BASE_URL=${VITE_ANALYTICS_API_BASE_URL:-/api}

# Firebase Web(REST 로그인) 설정
# - Analytics는 Firebase SDK 없이 REST API로 로그인하므로, 최소 apiKey만 있으면 동작한다.
# - 이 값이 빌드에 주입되지 않으면 앱이 로그인 단계에서 크래시(빈 화면)할 수 있으므로 반드시 주입한다.
ARG VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY:-}

# 증거(version.json) 주입용
# - vite.config.ts의 writeVersionJson() 플러그인이 아래 env를 읽는다.
ARG VITE_APP_VERSION
ARG VITE_IMAGE_TAG
ARG BUILD_TIME
ARG GIT_SHA
ENV VITE_APP_VERSION=${VITE_APP_VERSION:-}
ENV VITE_IMAGE_TAG=${VITE_IMAGE_TAG:-}
ENV BUILD_TIME=${BUILD_TIME:-}
ENV GIT_SHA=${GIT_SHA:-}

RUN npm run build

FROM nginx:1.27-alpine AS serve
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx","-g","daemon off;"]


